/**
 * @file      wireguard_secrets.h.example
 * @brief     Template for WireGuard secrets. Copy to wireguard_secrets.h and
 *            fill in your keys. wireguard_secrets.h is gitignored — NEVER commit
 *            it and NEVER print these values to Serial.
 *
 * Base64 keys, exactly as WireGuard emits them (`wg genkey` / `wg pubkey`).
 */
#pragma once

// [Interface] PrivateKey of THIS watch.
#define WG_PRIVATE_KEY      "REPLACE_WITH_DEVICE_PRIVATE_KEY_BASE64"

// [Peer] PublicKey of the server.
#define WG_PEER_PUBLIC_KEY  "REPLACE_WITH_SERVER_PUBLIC_KEY_BASE64"

// Optional [Peer] PresharedKey. Leave as nullptr to disable.
#define WG_PRESHARED_KEY    nullptr
